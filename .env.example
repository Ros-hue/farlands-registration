# ==============================================================================
# Farlands Hackathon: Registration & Payment Backend Environment Variables
# ==============================================================================

# Supabase Public Configuration (Exposed to browser client)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-publishable-anon-key"

# Supabase Server-Only Secrets (NEVER expose to browser client)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Manual UPI Payment Configuration (Server-side only)
# Set to the official UPI ID participants will transfer funds to (e.g. organizer@bank)
PAYMENT_UPI_ID="organizer@oksbi"

# Initial Organizer Admin Account (Used by `npm run provision:admin`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeThisPassword123!"
ADMIN_USERNAME="ADMIN"

# Server Configuration
PORT=3000
NODE_ENV="development"
